[node name="CeilingLight1" type="OmniLight3D" parent="Ship/Interior"]
# Practicals per §11 — dim, pooled light with shadowed corners, not a
# flat ambient wash. Three fixtures spaced along the room's long axis
# (z), deliberately not reaching the window (z=-5) or the back wall
# (z=5), so both ends stay dim. cull_mask restricted to the interior
# render layer so this can never bleed onto exterior geometry.
position = Vector3(0, 1.9, -3)
light_color = Color(1, 0.87, 0.7, 1)
light_energy = 4.0
light_cull_mask = 2
shadow_enabled = true
omni_range = 4.5

