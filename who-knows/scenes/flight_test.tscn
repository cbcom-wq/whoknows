[node name="Window" type="StaticBody3D" parent="Ship/Interior"]
# Physically seals the 3m gap left between WallN's two pillars. Without
# this, the gap in the collider is a gap the avatar can walk (or crawl)
# straight through into deep interior space, with no floor beyond z=-5 to
# catch them. Sealed floor-to-ceiling; see task-6-report.md for why this
# and WallN's pillars aren't a single centered 3m x 1.5m cutout.
position = Vector3(0, 1, -5)
collision_layer = 2
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ship/Interior/Window"]
shape = SubResource("BoxShape3D_window")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Ship/Interior/Window"]
# Transparent glass, not the seal — collision still comes entirely from
# the CollisionShape3D above. cast_shadow off so the pane doesn't throw
# an opaque shadow rectangle across the deck from the ceiling practicals.
layers = 2
cast_shadow = 0
mesh = SubResource("BoxMesh_window")
material_override = SubResource("StandardMaterial3D_window")

