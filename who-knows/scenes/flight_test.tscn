[sub_resource type="Gradient" id="Gradient_starfield"]
# Cellular noise returns low values right at each cell's feature point and
# rises quickly away from it, so a narrow white band near 0 with a fast
# falloff to black reads as sparse, pinpoint stars rather than clouds.
