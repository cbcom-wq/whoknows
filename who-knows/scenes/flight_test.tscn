[node name="Window" type="StaticBody3D" parent="Ship/Interior"]
# Physically seals the 3m gap left between WallN's two pillars. Without
# this, the gap in the collider is a gap the avatar can walk (or crawl)
# straight through — the interior shell has no visual wall meshes at all
# yet, so nothing else would stop them from stepping into deep interior
# space. Sealed floor-to-ceiling; see task-6-report.md for why this and
# WallN's pillars aren't a single centered 3m x 1.5m cutout.
position = Vector3(0, 1, -5)
collision_layer = 2
collision_mask = 0

